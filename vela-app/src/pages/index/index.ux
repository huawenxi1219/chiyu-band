<template>
	<div class="page" @touchstart="onTouchStart" @touchmove="onTouchMove" @touchend="onTouchEnd">

		<!-- 首页：词库状态 -->
		<div if="{{mode === 'home'}}" class="home">
			<div class="homeCard">
				<text class="appName">池鱼单词</text>
				<text class="ver">v0.8</text>
				<text class="stat">今日待复习 {{dueCount}} 词</text>
				<text class="stat2">词库共 {{totalCount}} 词</text>
				<div class="btn" @click="startRound">
					<text class="btnText">开始背单词</text>
				</div>
				<text if="{{debug}}" class="dbg">{{debug}}</text>
				<text if="{{diag1}}" class="diag">{{diag1}}</text>
				<text if="{{diag2}}" class="diag">{{diag2}}</text>
				<text class="hint2">右滑退出 · 连手机可同步词库</text>
				<div class="btnExit" @click="exitApp">
					<text class="btnExitText">退出</text>
				</div>
			</div>
		</div>

		<!-- 背单词：单词卡（左滑=认识 上滑=模糊 下滑=不会 右滑=退出） -->
		<div if="{{mode === 'study'}}" class="card {{animClass}}">
			<div class="miniExit" @click="exitApp"><text class="miniExitText">退</text></div>
			<div class="prog"><div class="progFill" style="width: {{progPct}}%"></div></div>
			<text class="word">{{curWord.w}}</text>
			<text class="pos">{{roundDone}}/{{totalCount}} · 词库共 {{totalCount}}</text>
			<text class="hint">←认识  ↑模糊  ↓不会  →退出</text>
		</div>

		<!-- 释义页（轻点继续，右滑退出） -->
		<div if="{{mode === 'meaning'}}" class="card animIn">
			<div class="miniExit" @click="exitApp"><text class="miniExitText">退</text></div>
			<text class="word">{{curWord.w}}</text>
			<text class="mean">{{curWord.m}}</text>
			<text class="actText">{{lastActText}}</text>
			<text class="hint2">轻点继续 · 右滑退出</text>
		</div>

		<!-- 本轮完成 -->
		<div if="{{mode === 'done'}}" class="card animIn">
			<text class="title2">本轮完成</text>
			<text class="stat">认识 {{statK}} · 模糊 {{statF}} · 不会 {{statN}}</text>
			<text if="{{retryCount > 0}}" class="stat2">其中 {{retryCount}} 词复考巩固</text>
			<div class="btn" @click="startRound">
				<text class="btnText">再来一轮</text>
			</div>
			<div class="btnExit" @click="exitApp">
				<text class="btnExitText">退出</text>
			</div>
			<text class="hint2">右滑退出</text>
		</div>
	</div>
</template>

<script>
import storage from '../../common/storage.js'
import srs from '../../common/srs.js'
import brightness from '@system.brightness'
import app from '@system.app'
import router from '@system.router'

export default {
	private: {
		mode: 'home',        // home | study | meaning | done
		words: [],
		answered: {},        // 本轮已答过的词（全库动态选词防重复）
		idx: 0,
		curWord: { w: '', m: '' },
		dueCount: 0,
		totalCount: 0,
		statK: 0,
		statF: 0,
		statN: 0,
		lastActText: '',
		studyStart: 0,     // 当前词显示时刻（用于算反应时间）
		meaningStart: 0,   // 释义显示时刻（用于算停留时间）
		pendingRec: null,  // 待补 dwell 的记录
		gapHours: 24,      // 用户使用频率（小时），打开时估算，决定基础复习间隔
		animClass: 'animIn', // 卡片动画：animIn | flyL | flyU | flyD
		choosing: false,     // 防连点：滑动选词动画期间的输入锁
		roundDone: 0,      // 本轮已答题数（含复考）
		progPct: 0,        // 本轮进度 %
		retryQueue: [],    // 轮内复考队列（选"不会/模糊"的词）
		retryCounts: {},   // 词 → 本轮已复考次数（上限 2 次，防循环）
		sinceRetry: 0,     // 距上次复考已走了几步（每 2 步插一次复考）
		retryCount: 0,     // 本轮实际复考次数
		debug: '',
		diag1: '',      // 诊断日志（最近一条，推送排障时显示）
		diag2: '',      // 诊断日志（倒数第二条）
		diagTimer: null
	},
	touch: { sx: 0, sy: 0, active: false },

	onShow() {
		this.reloadWords()
		// 手环端应用就绪后主动回报握手（配合手机端推送前等待，防止启动慢丢消息）
		try { globalThis.conn && globalThis.conn.send('__hs__', { count: 1 }) } catch (e) { }
		// 打开时估算使用频率，让算法动态定基础间隔（高频→几小时巩固）
		var that = this
		storage.get('records', []).then(function (recs) {
			that.gapHours = srs.estimateGapHours(recs)
		})
		// 诊断日志轮询：每 600ms 从共享存储读最近 2 条收发记录（多行分别显示，避免 \n 渲染异常）
		this.diagTimer = setInterval(function () {
			storage.get('diag', []).then(function (arr) {
				var list = (arr && arr.length) ? arr : (globalThis.__diag || [])
				if (list && list.length) {
					var n = list.length
					that.diag1 = list[n - 1]
					that.diag2 = (n >= 2) ? list[n - 2] : ''
				}
			}).catch(function () {
				var list = globalThis.__diag || []
				if (list.length) {
					var n = list.length
					that.diag1 = list[n - 1]
					that.diag2 = (n >= 2) ? list[n - 2] : ''
				}
			})
		}, 600)
	},

	onHide() {
		if (this.diagTimer) { clearInterval(this.diagTimer); this.diagTimer = null }
	},

	reloadWords() {
		var that = this
		storage.get('words', []).then(function (list) {
			that.words = list || []
			that.totalCount = that.words.length
			var due = 0
			for (var i = 0; i < that.words.length; i++) {
				var w = srs.norm(that.words[i])
				if (srs.retention(w) < 0.9) due++
			}
			that.dueCount = due
		})
	},

	startRound() {
		if (!this.words.length) {
			this.debug = '词库为空，请先用手机同步'
			return
		}
		// 全库动态选词：每个词独立计算紧迫度，先学最该学的
		this.answered = {}
		this.idx = 0
		this.statK = 0
		this.statF = 0
		this.statN = 0
		this.pendingRec = null
		this.roundDone = 0
		this.progPct = 0
		this.retryQueue = []
		this.retryCounts = {}
		this.sinceRetry = 0
		this.retryCount = 0
		this.choosing = false
		this.animClass = 'animIn'
		var first = srs.pickNextAll(this.words, this.answered)
		if (!first) {
			this.debug = '词库为空，请先用手机同步'
			return
		}
		this.curWord = first
		this.studyStart = Date.now()
		this.mode = 'study'
		this.debug = ''
		try { brightness.setKeepScreenOn({ keepScreenOn: true }) } catch (e) { }
	},

	onTouchStart(e) {
		var t = e.touches[0]
		this.touch.sx = t.clientX
		this.touch.sy = t.clientY
		this.touch.active = true
	},

	onTouchMove() { },

	onTouchEnd(e) {
		if (!this.touch.active) return
		this.touch.active = false
		var t = e.changedTouches ? e.changedTouches[0] : (e.touches[0] || {})
		var ex = t.clientX
		var ey = t.clientY
		var dx = ex - this.touch.sx
		var dy = ey - this.touch.sy
		var ax = Math.abs(dx)
		var ay = Math.abs(dy)
		var isTap = ax < 20 && ay < 20
		// 右滑 = 退出应用（任何界面都生效，符合手环习惯）
		if (ax >= ay && dx > 0) {
			this.exitApp()
			return
		}
		// 释义页：轻点继续下一词（同时记下释义停留时间）
		if (this.mode === 'meaning' && isTap) {
			this.nextWord()
			return
		}
		if (isTap) return   // 其它界面轻点忽略
		// 背单词三选一：左滑=认识 上滑=模糊 下滑=不会
		if (this.mode !== 'study') return
		var action = null
		if (ay > ax && dy < 0) action = 'fuzzy'          // 上滑 = 模糊
		else if (ay > ax && dy > 0) action = 'forget'    // 下滑 = 不会
		else if (ax >= ay && dx < 0) action = 'know'     // 左滑 = 认识
		if (action) this.choose(action, Date.now() - this.studyStart)
	},

	exitApp() {
		// 退出前保存当前进度（记录已在 nextWord 时实时写入）
		try { brightness.setKeepScreenOn({ keepScreenOn: false }) } catch (e) { }
		try { app.terminate() } catch (e) { }
		// 兜底：terminate 未生效时清空页面栈回到桌面
		setTimeout(function () {
			try { router.clear() } catch (e) { }
		}, 300)
	},

	onBackPress() {
		// 手环物理返回键：答题中回首页，首页/完成页直接退出
		if (this.mode === 'study' || this.mode === 'meaning') {
			this.mode = 'home'
			this.pendingRec = null
			try { brightness.setKeepScreenOn({ keepScreenOn: false }) } catch (e) { }
		} else {
			this.exitApp()
		}
		return true
	},

	choose(action, rt) {
		if (this.choosing) return
		this.choosing = true
		// 先更新 SRS（含反应时间 + 使用频率），记录暂存，释义停留后补 dwell 再落盘
		var rec = srs.updateWord(this.curWord, action, { rt: rt, gap: this.gapHours })
		this.pendingRec = rec
		if (action === 'know') this.statK++
		else if (action === 'fuzzy') this.statF++
		else this.statN++
		this.lastActText = action === 'know' ? '认识 ✓' : (action === 'fuzzy' ? '模糊 ~' : '不会 ✗')
		this.roundDone++
		this.progPct = Math.min(100, Math.round(this.roundDone / this.totalCount * 100))
		// 轮内复考：选"不会/模糊"的词进队列，每走 2 步插回来再考一次（同词最多复考 2 次）
		if (action !== 'know') {
			var key = (this.curWord.w || '').toLowerCase()
			var done = this.retryCounts[key] || 0
			if (done < 2) {
				var inQueue = false
				for (var q = 0; q < this.retryQueue.length; q++) {
					if (this.retryQueue[q].key === key) { inQueue = true; break }
				}
				if (!inQueue) {
					this.retryQueue.push({ key: key, word: this.curWord, times: 1 })
				}
			}
		}
		// 滑动方向飞出动画（左=认识 上=模糊 下=不会），动画结束后进释义页
		this.animClass = action === 'know' ? 'flyL' : (action === 'fuzzy' ? 'flyU' : 'flyD')
		var that = this
		setTimeout(function () {
			that.animClass = 'animIn'
			that.showMeaning()
		}, 280)
	},

	showMeaning() {
		this.choosing = false
		this.mode = 'meaning'
		this.meaningStart = Date.now()
	},

	nextWord() {
		// 补上释义停留时间，落盘记录
		if (this.pendingRec) {
			this.pendingRec.dwell = Date.now() - this.meaningStart
			var that = this
			storage.get('records', []).then(function (recs) {
				recs.push(that.pendingRec)
				if (recs.length > 500) recs = recs.slice(recs.length - 500)
				storage.set('records', recs)
			})
			this.pendingRec = null
		}
		this.answered[this.curWord.w.toLowerCase()] = true
		// 轮内复考：每走 2 步，从队列取一个"不会/模糊"的词回来再考
		// 复考时更新 SRS 状态（第二次作答更准），答对即出队，仍不会继续排队（最多 2 次）
		this.sinceRetry++
		if (this.retryQueue.length && this.sinceRetry >= 2) {
			var rw = this.retryQueue.shift()
			this.sinceRetry = 0
			this.retryCount++
			this.retryCounts[rw.key] = (this.retryCounts[rw.key] || 0) + 1
			this.curWord = rw.word
			this.studyStart = Date.now()
			this.mode = 'study'
			this.animClass = 'animIn'
			this.debug = '复考:' + rw.key
			return
		}
		this.debug = ''
		// 全库动态选词：排除已答，从整个词库挑当下最紧急的一个
		// 每个词独立计算（遗忘曲线+熟练度+错次+刚更新的状态），轻微随机防同序
		var next = srs.pickNextAll(this.words, this.answered)
		if (next) {
			this.idx++
			this.curWord = next
			this.studyStart = Date.now()
			this.mode = 'study'
			this.animClass = 'animIn'
		} else {
			// 整个词库学完一遍
			this.idx = this.words.length
			this.mode = 'done'
			storage.set('words', this.words)
			try { brightness.setKeepScreenOn({ keepScreenOn: false }) } catch (e) { }
		}
	}
}
</script>

<style>
/* AstroBox 风格：深色 #0D0D0F · 主色 #1781FF · 大圆角卡片 */
.page {
	width: 212px;
	height: 520px;
	background-color: #0D0D0F;
	flex-direction: column;
	align-items: center;
}

/* 入场动画：缩放 + 淡入 */
@keyframes popIn {
	from { transform: scale(0.92); opacity: 0; }
	to { transform: scale(1); opacity: 1; }
}

.animIn {
	animation: popIn 0.3s cubic-bezier(0.18, 0.86, 0.34, 1);
}

/* 三向飞出动画：左=认识 上=模糊 下=不会（AstroBox 式滑动反馈） */
@keyframes flyL {
	to { transform: translateX(-240px); opacity: 0; }
}

@keyframes flyU {
	to { transform: translateY(-560px); opacity: 0; }
}

@keyframes flyD {
	to { transform: translateY(560px); opacity: 0; }
}

.flyL { animation: flyL 0.28s ease-out; }
.flyU { animation: flyU 0.28s ease-out; }
.flyD { animation: flyD 0.28s ease-out; }

/* 本轮进度条（答题卡顶部细条） */
.prog {
	position: absolute;
	top: 12px;
	left: 16px;
	width: 164px;
	height: 4px;
	border-radius: 2px;
	background-color: rgba(255, 255, 255, 0.08);
}

.progFill {
	height: 4px;
	border-radius: 2px;
	background-color: #1781FF;
}

.home {
	width: 212px;
	height: 440px;
	margin-top: 60px;
	flex-direction: column;
	align-items: center;
	justify-content: flex-start;
}

/* 首页浮层卡片（AstroBox 大圆角半透明层风格） */
.homeCard {
	width: 196px;
	height: 440px;
	border-radius: 28px;
	background-color: rgba(255, 255, 255, 0.05);
	flex-direction: column;
	align-items: center;
	justify-content: flex-start;
}

/* 大圆角浮层卡片 */
.card {
	width: 196px;
	height: 440px;
	margin-top: 60px;
	border-radius: 28px;
	background-color: rgba(255, 255, 255, 0.05);
	flex-direction: column;
	align-items: center;
	justify-content: center;
}

.appName {
	font-size: 40px;
	font-weight: bold;
	color: #FFFFFF;
	margin-top: 60px;
}

.ver {
	font-size: 18px;
	color: #3F6FA8;
	margin-top: 2px;
}

.title2 {
	font-size: 38px;
	font-weight: bold;
	color: #FFFFFF;
	margin-top: 40px;
}

.stat {
	font-size: 26px;
	color: #5BA3FF;
	margin-top: 18px;
}

.stat2 {
	font-size: 24px;
	color: #888888;
	margin-top: 6px;
}

.word {
	font-size: 58px;
	font-weight: bold;
	color: #FFFFFF;
	text-align: center;
	lines: 2;
	text-overflow: clip;
	margin-left: 16px;
	margin-right: 16px;
}

.mean {
	font-size: 26px;
	color: #CCCCCC;
	text-align: center;
	lines: 6;
	text-overflow: clip;
	margin-left: 16px;
	margin-right: 16px;
	margin-top: 24px;
}

.pos {
	font-size: 22px;
	color: #666666;
	margin-top: 14px;
}

.hint {
	font-size: 20px;
	color: #555555;
	margin-top: 10px;
}

.hint2 {
	font-size: 20px;
	color: #444444;
	margin-top: 30px;
}

.actText {
	font-size: 24px;
	color: #5BA3FF;
	margin-top: 18px;
}

/* 实心主色按钮（AstroBox 强调色 #1781FF） */
.btn {
	width: 156px;
	height: 56px;
	border-radius: 28px;
	background-color: #1781FF;
	align-items: center;
	justify-content: center;
	margin-top: 34px;
	transition: transform 0.15s ease-in-out;
}

.btnText {
	font-size: 26px;
	color: #FFFFFF;
	font-weight: bold;
}

/* 次要退出按钮（半透明小按钮，点击退出应用） */
.btnExit {
	width: 96px;
	height: 44px;
	border-radius: 22px;
	background-color: rgba(255, 255, 255, 0.06);
	align-items: center;
	justify-content: center;
	margin-top: 16px;
	transition: transform 0.15s ease-in-out;
}

.btnExitText {
	font-size: 22px;
	color: #888888;
	font-weight: bold;
}

/* 词库为空等提示：卡片内流式红字（限宽防横向溢出，绝不遮挡退出键） */
.dbg {
	font-size: 18px;
	color: #CC4444;
	margin-top: 16px;
	width: 180px;
	text-align: center;
}

/* 诊断日志（小号灰色，多行分别显示，推送排障用） */
.diag {
	font-size: 16px;
	color: #8A8A8A;
	margin-top: 6px;
	width: 180px;
	text-align: center;
}

/* 答题/释义页右上角小退出按钮（任何状态下都有显式出口） */
.miniExit {
	position: absolute;
	top: 10px;
	right: 10px;
	width: 40px;
	height: 40px;
	border-radius: 20px;
	background-color: rgba(255, 255, 255, 0.10);
	align-items: center;
	justify-content: center;
}

.miniExitText {
	font-size: 20px;
	color: #AAAAAA;
	font-weight: bold;
}
</style>
