<template>
	<div class="page" @touchstart="onTouchStart" @touchmove="onTouchMove" @touchend="onTouchEnd">

		<!-- 首页：词库状态 -->
		<div if="{{mode === 'home'}}" class="home">
			<div class="homeCard">
				<text class="appName">池鱼单词</text>
				<text class="ver">v0.26</text>
				<text class="stat">内置词库 {{totalCount}} 词 · 标准版</text>
				<text class="stat2">开始即学最该复习的词</text>
				<div class="btn" @click="startRound">
					<text class="btnText">开始背单词</text>
				</div>
				<text if="{{debug}}" class="dbg">{{debug}}</text>
				<text class="hint2">点按钮选词 · 右滑也可退出</text>
				<div class="btnExit" @click="exitApp">
					<text class="btnExitText">退出</text>
				</div>
			</div>
		</div>

		<!-- 背单词：单词卡（三按钮为主，手势为辅） -->
		<div if="{{mode === 'study'}}" class="card {{animClass}}">
			<div class="miniExit" @click="exitApp"><text class="miniExitText">退</text></div>
			<div class="prog"><div class="progFill" style="width: {{progPct}}%"></div></div>
			<text class="word">{{curWord.w}}</text>
			<text class="pos">第{{roundNo}}批 {{roundDone}}/{{batchSize}}</text>
			<text class="hint">点下方按钮选词</text>
			<div class="btnRow">
				<div class="btnK" @click="chooseBtn('know')"><text class="btnKText">认识</text></div>
				<div class="btnF" @click="chooseBtn('fuzzy')"><text class="btnFText">模糊</text></div>
				<div class="btnN" @click="chooseBtn('forget')"><text class="btnNText">不会</text></div>
			</div>
		</div>

		<!-- 释义页（轻点继续，按钮继续） -->
		<div if="{{mode === 'meaning'}}" class="card animIn">
			<div class="miniExit" @click="exitApp"><text class="miniExitText">退</text></div>
			<text class="word">{{curWord.w}}</text>
			<text class="mean">{{curWord.m}}</text>
			<text class="actText">{{lastActText}}</text>
			<text class="hint2">轻点或点按钮继续</text>
			<div class="btnNext" @click="nextWord"><text class="btnNextText">下一个</text></div>
		</div>

		<!-- 今日全部学完 -->
		<div if="{{mode === 'done'}}" class="card animIn">
			<text class="title2">今日完成</text>
			<text class="stat">认识 {{statK}} · 模糊 {{statF}} · 不会 {{statN}}</text>
			<text if="{{retryCount > 0}}" class="stat2">其中 {{retryCount}} 词复考巩固</text>
			<text class="stat2">今天该复习的都已复习</text>
			<div class="btnExit" @click="exitApp">
				<text class="btnExitText">退出</text>
			</div>
			<text class="hint2">明天再来背新词</text>
		</div>
	</div>
</template>

<script>
import storage from '../../common/storage.js'
import srs from '../../common/srs.js'
import words from '../../common/words.js'
import brightness from '@system.brightness'
import app from '@system.app'
import router from '@system.router'

// v0.26 内置词库架构：标准高考3500+外研必修词（4678词）直接打包进应用，
// 无需手机推送词表。学习进度（srsmap/records）仍存手环本地，手机连接后只做数据收集。
const BATCH_SIZE = 30   // 每批学习词数（内存安全，防 OOM 重启）
const DAILY_NEW = 25    // 每天最多引入的新词数（首轮约187天学完，符合真实背词节奏）

export default {
	private: {
		mode: 'home',        // home | study | meaning | done
		words: [],           // 当前批次完整词对象（≤BATCH_SIZE 个）
		roundNo: 0,          // 当前批次序号（第几批）
		batchSize: 0,        // 当前批次词数
		idx: 0,
		curWord: { w: '', m: '' },
		totalCount: 0,
		statK: 0,
		statF: 0,
		statN: 0,
		lastActText: '',
		studyStart: 0,     // 当前词显示时刻（用于算反应时间）
		meaningStart: 0,   // 释义显示时刻（用于算停留时间）
		pendingRec: null,  // 待补 dwell 的记录
		gapHours: 24,      // 用户使用频率（小时），打开时估算，决定基础复习间隔
		animClass: 'animIn',
		roundDone: 0,      // 本批已答题数（含复考）
		progPct: 0,        // 本批进度 %
		retryQueue: [],    // 批内复考队列（选"不会/模糊"的词）
		retryCounts: {},   // 词 → 本批已复考次数（上限 2 次，防循环）
		sinceRetry: 0,     // 距上次复考已走了几步（每 2 步插一次复考）
		retryCount: 0,     // 本批实际复考次数
		debug: ''
	},
	touch: { sx: 0, sy: 0, active: false },

	onShow() {
		var that = this
		this.totalCount = words.length
		// 打开时估算使用频率，让算法动态定基础间隔
		storage.get('records', []).then(function (recs) {
			that.gapHours = srs.estimateGapHours(recs)
		})
		// 手环端应用就绪后主动回报握手（配合手机端连接）
		try { globalThis.conn && globalThis.conn.send('__hs__', { count: 1 }) } catch (e) { }
	},

	onHide() {
	},

	startRound() {
		this.beginRound()
	},

	beginRound() {
		this.statK = 0
		this.statF = 0
		this.statN = 0
		this.pendingRec = null
		this.retryCount = 0
		this.debug = ''
		this.roundNo = 0
		this.loadNextBatch()
	},

	// 从内置全库中筛出今天该学的词（到期复习 + 新词配额），按遗忘曲线紧迫度取最该复习的 BATCH_SIZE 个
	loadNextBatch() {
		var that = this
		this.debug = '正在准备单词...'
		storage.get('srsmap', {}).then(function (map) {
			storage.get('lastNewDay', '').then(function (day) {
				storage.get('newLearned', 0).then(function (newCnt) {
					var today = new Date().toISOString().slice(0, 10)
					if (day !== today) {
						day = today
						newCnt = 0
					}
					var now = Date.now()
					var pool = []
					for (var i = 0; i < words.length; i++) {
						var w = words[i]
						var s = map[(w.w || '').toLowerCase()]
						if (s) {
							// 复习词：到期才进池
							if (!s.next || s.next <= now) {
								w.e = s.e; w.i = s.i; w.lvl = s.lvl
								w.c = s.c; w.wc = s.wc; w.next = s.next
								pool.push(w)
							}
						} else if (newCnt < DAILY_NEW) {
							// 新词：当天配额内进池
							newCnt++
							pool.push(w)
						}
					}
					// 紧迫度排序（无记录的新词排前面先学）
					var tmp = []
					for (var k = 0; k < pool.length; k++) {
						var w2 = pool[k]
						var rec = map[(w2.w || '').toLowerCase()]
						w2.isNew = !rec
						var ret = rec ? srs.retention(srs.norm(w2)) : 0
						tmp.push({ ret: ret, word: w2 })
					}
					tmp.sort(function (a, b) { return a.ret - b.ret })
					var n = Math.min(BATCH_SIZE, tmp.length)
					var batch = []
					for (var m = 0; m < n; m++) batch.push(tmp[m].word)
					tmp = null
					try { global.runGC && global.runGC() } catch (e) { }
					if (!batch.length) {
						that.mode = 'done'
						that.words = []
						that.debug = ''
						try { brightness.setKeepScreenOn({ keepScreenOn: false }) } catch (e) { }
						return
					}
					// 落盘新词日计数
					storage.set('lastNewDay', today)
					storage.set('newLearned', newCnt)
					that.words = batch
					that.batchSize = batch.length
					that.roundNo++
					that.idx = 0
					that.answered = {}
					that.retryQueue = []
					that.retryCounts = {}
					that.sinceRetry = 0
					that.roundDone = 0
					that.animClass = 'animIn'
					that.curWord = batch[0]
					that.studyStart = Date.now()
					that.mode = 'study'
					that.debug = ''
					try { brightness.setKeepScreenOn({ keepScreenOn: true }) } catch (e) { }
				})
			})
		})
	},

	chooseBtn(action) {
		this.choose(action, Date.now() - this.studyStart)
	},

	onTouchStart(e) {
		var t = e.touches[0]
		this.touch.sx = t.clientX
		this.touch.sy = t.clientY
		this.touch.active = true
	},

	onTouchMove() { },

	onTouchEnd(e) {
		if (!this.touch.active) return
		this.touch.active = false
		var t = (e && e.changedTouches && e.changedTouches[0]) ? e.changedTouches[0] : ((e && e.touches && e.touches[0]) || null)
		if (!t || typeof t.clientX !== 'number') return
		var ex = t.clientX
		var ey = t.clientY
		var dx = ex - this.touch.sx
		var dy = ey - this.touch.sy
		var ax = Math.abs(dx)
		var ay = Math.abs(dy)
		var isTap = ax < 20 && ay < 20
		// 右滑 = 退出应用（任何界面都生效，符合手环习惯）
		if (ax >= ay && dx > 0) {
			this.exitApp()
			return
		}
		// 释义页：轻点继续下一词
		if (this.mode === 'meaning' && isTap) {
			this.nextWord()
			return
		}
		if (isTap) return
		// 背单词手势（按钮为主，手势为辅）
		if (this.mode !== 'study') return
		var action = null
		if (ay > ax && dy < 0) action = 'fuzzy'
		else if (ay > ax && dy > 0) action = 'forget'
		else if (ax >= ay && dx < 0) action = 'know'
		if (action) this.choose(action, Date.now() - this.studyStart)
	},

	exitApp() {
		try { brightness.setKeepScreenOn({ keepScreenOn: false }) } catch (e) { }
		try { app.terminate() } catch (e) { }
		setTimeout(function () {
			try { router.clear() } catch (e) { }
		}, 300)
	},

	onBackPress() {
		if (this.mode === 'study' || this.mode === 'meaning') {
			this.mode = 'home'
			this.pendingRec = null
			try { brightness.setKeepScreenOn({ keepScreenOn: false }) } catch (e) { }
		} else {
			this.exitApp()
		}
		return true
	},

	choose(action, rt) {
		// 同步执行，100% 可靠（无 choosing 锁、无 setTimeout，防 Vela 卡死）
		var rec = srs.updateWord(this.curWord, action, { rt: rt, gap: this.gapHours })
		this.pendingRec = rec
		if (action === 'know') this.statK++
		else if (action === 'fuzzy') this.statF++
		else this.statN++
		this.lastActText = action === 'know' ? '认识 ✓' : (action === 'fuzzy' ? '模糊 ~' : '不会 ✗')
		this.roundDone++
		this.progPct = Math.min(100, Math.round(this.roundDone / this.batchSize * 100))
		// 轮内复考：选"不会/模糊"的词进队列，每走 2 步插回来再考一次（同词最多复考 2 次）
		if (action !== 'know') {
			var key = (this.curWord.w || '').toLowerCase()
			var done = this.retryCounts[key] || 0
			if (done < 2) {
				var inQueue = false
				for (var q = 0; q < this.retryQueue.length; q++) {
					if (this.retryQueue[q].key === key) { inQueue = true; break }
				}
				if (!inQueue) {
					this.retryQueue.push({ key: key, word: this.curWord, times: 1 })
				}
			}
		}
		// 进释义页（同步，无动画等待）
		this.choosing = false
		this.mode = 'meaning'
		this.meaningStart = Date.now()
	},

	nextWord() {
		// 补上释义停留时间，落盘记录
		if (this.pendingRec) {
			this.pendingRec.dwell = Date.now() - this.meaningStart
			var that = this
			storage.get('records', []).then(function (recs) {
				recs.push(that.pendingRec)
				if (recs.length > 500) recs = recs.slice(recs.length - 500)
				storage.set('records', recs)
			})
			// SRS 学习进度独立落盘
			var cw = this.curWord
			storage.get('srsmap', {}).then(function (map) {
				map[(cw.w || '').toLowerCase()] = { e: cw.e, i: cw.i, lvl: cw.lvl, c: cw.c, wc: cw.wc, next: cw.next }
				storage.set('srsmap', map)
			})
			this.pendingRec = null
		}
		this.answered[this.curWord.w.toLowerCase()] = true
		// 轮内复考
		this.sinceRetry++
		if (this.retryQueue.length && this.sinceRetry >= 2) {
			var rw = this.retryQueue.shift()
			this.sinceRetry = 0
			this.retryCount++
			this.retryCounts[rw.key] = (this.retryCounts[rw.key] || 0) + 1
			this.curWord = rw.word
			this.studyStart = Date.now()
			this.mode = 'study'
			this.animClass = 'animIn'
			this.debug = '复考:' + rw.key
			return
		}
		this.debug = ''
		this.idx++
		if (this.idx < this.words.length) {
			this.curWord = this.words[this.idx]
			this.studyStart = Date.now()
			this.mode = 'study'
			this.animClass = 'animIn'
		} else {
			this.batchDone()
		}
	},

	batchDone() {
		var that = this
		// 本批学习进度合并写入 srsmap
		storage.get('srsmap', {}).then(function (map) {
			for (var i2 = 0; i2 < that.words.length; i2++) {
				var cw = that.words[i2]
				map[(cw.w || '').toLowerCase()] = { e: cw.e, i: cw.i, lvl: cw.lvl, c: cw.c, wc: cw.wc, next: cw.next }
			}
			storage.set('srsmap', map)
		})
		// 释放本批完整词对象，加载下一批（今天还有该学的词就继续，没有则完成）
		this.words = []
		this.answered = {}
		try { global.runGC && global.runGC() } catch (e) { }
		this.loadNextBatch()
	}
}
</script>

<style>
/* AstroBox 风格：深色 #0D0D0F · 主色 #1781FF · 大圆角卡片 */
.page {
	width: 212px;
	height: 520px;
	background-color: #0D0D0F;
	flex-direction: column;
	align-items: center;
}

/* 入场动画：缩放 + 淡入 */
@keyframes popIn {
	from { transform: scale(0.92); opacity: 0; }
	to { transform: scale(1); opacity: 1; }
}

.animIn {
	animation: popIn 0.3s cubic-bezier(0.18, 0.86, 0.34, 1);
}

/* 三向飞出动画：左=认识 上=模糊 下=不会（AstroBox 式滑动反馈） */
@keyframes flyL {
	to { transform: translateX(-240px); opacity: 0; }
}

@keyframes flyU {
	to { transform: translateY(-560px); opacity: 0; }
}

@keyframes flyD {
	to { transform: translateY(560px); opacity: 0; }
}

.flyL { animation: flyL 0.28s ease-out; }
.flyU { animation: flyU 0.28s ease-out; }
.flyD { animation: flyD 0.28s ease-out; }

/* 本轮进度条（答题卡顶部细条） */
.prog {
	position: absolute;
	top: 12px;
	left: 16px;
	width: 164px;
	height: 4px;
	border-radius: 2px;
	background-color: rgba(255, 255, 255, 0.08);
}

.progFill {
	height: 4px;
	border-radius: 2px;
	background-color: #1781FF;
}

.home {
	width: 212px;
	height: 440px;
	margin-top: 60px;
	flex-direction: column;
	align-items: center;
	justify-content: flex-start;
}

/* 首页浮层卡片（AstroBox 大圆角半透明层风格） */
.homeCard {
	width: 196px;
	height: 440px;
	border-radius: 28px;
	background-color: rgba(255, 255, 255, 0.05);
	flex-direction: column;
	align-items: center;
	justify-content: flex-start;
}

/* 大圆角浮层卡片 */
.card {
	width: 196px;
	height: 440px;
	margin-top: 60px;
	border-radius: 28px;
	background-color: rgba(255, 255, 255, 0.05);
	flex-direction: column;
	align-items: center;
	justify-content: center;
}

.appName {
	font-size: 40px;
	font-weight: bold;
	color: #FFFFFF;
	margin-top: 60px;
}

.ver {
	font-size: 18px;
	color: #3F6FA8;
	margin-top: 2px;
}

.title2 {
	font-size: 38px;
	font-weight: bold;
	color: #FFFFFF;
	margin-top: 40px;
}

.stat {
	font-size: 26px;
	color: #5BA3FF;
	margin-top: 18px;
}

.stat2 {
	font-size: 24px;
	color: #888888;
	margin-top: 6px;
}

.word {
	font-size: 58px;
	font-weight: bold;
	color: #FFFFFF;
	text-align: center;
	lines: 2;
	text-overflow: clip;
	margin-left: 16px;
	margin-right: 16px;
}

.mean {
	font-size: 26px;
	color: #CCCCCC;
	text-align: center;
	lines: 6;
	text-overflow: clip;
	margin-left: 16px;
	margin-right: 16px;
	margin-top: 24px;
}

.pos {
	font-size: 22px;
	color: #666666;
	margin-top: 14px;
}

.hint {
	font-size: 20px;
	color: #555555;
	margin-top: 10px;
}

.hint2 {
	font-size: 20px;
	color: #444444;
	margin-top: 30px;
}

.actText {
	font-size: 24px;
	color: #5BA3FF;
	margin-top: 18px;
}

/* 实心主色按钮（AstroBox 强调色 #1781FF） */
.btn {
	width: 156px;
	height: 56px;
	border-radius: 28px;
	background-color: #1781FF;
	align-items: center;
	justify-content: center;
	margin-top: 34px;
	transition: transform 0.15s ease-in-out;
}

.btnText {
	font-size: 26px;
	color: #FFFFFF;
	font-weight: bold;
}

/* 次要退出按钮（半透明小按钮，点击退出应用） */
.btnExit {
	width: 96px;
	height: 44px;
	border-radius: 22px;
	background-color: rgba(255, 255, 255, 0.06);
	align-items: center;
	justify-content: center;
	margin-top: 16px;
	transition: transform 0.15s ease-in-out;
}

.btnExitText {
	font-size: 22px;
	color: #888888;
	font-weight: bold;
}

/* 词库为空等提示：卡片内流式红字（限宽防横向溢出，绝不遮挡退出键） */
.dbg {
	font-size: 18px;
	color: #CC4444;
	margin-top: 16px;
	width: 180px;
	text-align: center;
}

/* 诊断日志（小号灰色，多行分别显示，推送排障用） */
.diag {
	font-size: 16px;
	color: #8A8A8A;
	margin-top: 6px;
	width: 180px;
	text-align: center;
}

/* 答题/释义页右上角小退出按钮（任何状态下都有显式出口） */
.miniExit {
	position: absolute;
	top: 10px;
	right: 10px;
	width: 40px;
	height: 40px;
	border-radius: 20px;
	background-color: rgba(255, 255, 255, 0.10);
	align-items: center;
	justify-content: center;
}

.miniExitText {
	font-size: 20px;
	color: #AAAAAA;
	font-weight: bold;
}

/* ===== v0.26 按钮交互：认识/模糊/不会 三选一 + 下一个 ===== */
.btnRow {
	width: 176px;
	height: 72px;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	margin-top: 26px;
}

.btnK {
	width: 52px;
	height: 52px;
	border-radius: 26px;
	background-color: rgba(80, 200, 120, 0.25);
	align-items: center;
	justify-content: center;
	border: 2px solid #50C878;
}

.btnKText {
	font-size: 20px;
	color: #A7E8C1;
	font-weight: bold;
}

.btnF {
	width: 52px;
	height: 52px;
	border-radius: 26px;
	background-color: rgba(255, 193, 7, 0.20);
	align-items: center;
	justify-content: center;
	border: 2px solid #FFC107;
}

.btnFText {
	font-size: 20px;
	color: #FFE0A3;
	font-weight: bold;
}

.btnN {
	width: 52px;
	height: 52px;
	border-radius: 26px;
	background-color: rgba(255, 82, 82, 0.22);
	align-items: center;
	justify-content: center;
	border: 2px solid #FF5252;
}

.btnNText {
	font-size: 20px;
	color: #FFB0B0;
	font-weight: bold;
}

.btnNext {
	width: 120px;
	height: 46px;
	border-radius: 23px;
	background-color: rgba(23, 129, 255, 0.30);
	align-items: center;
	justify-content: center;
	border: 2px solid #1781FF;
