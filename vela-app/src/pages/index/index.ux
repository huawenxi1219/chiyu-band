<template>
	<div class="page" @touchstart="onTouchStart" @touchmove="onTouchMove" @touchend="onTouchEnd">

		<!-- 首页：词库状态 -->
		<div if="{{mode === 'home'}}" class="home">
			<div class="homeCard">
				<text class="appName">池鱼单词</text>
				<text class="ver">v0.25</text>
				<text class="stat">词库共 {{totalCount}} 词 · 已同步</text>
				<text class="stat2">开始即学最该复习的词</text>
				<div class="btn" @click="startRound">
					<text class="btnText">开始背单词</text>
				</div>
				<text if="{{debug}}" class="dbg">{{debug}}</text>
				<text if="{{diag1}}" class="diag">{{diag1}}</text>
				<text if="{{diag2}}" class="diag">{{diag2}}</text>
				<text class="hint2">右滑退出 · 连手机可同步词库</text>
				<div class="btnExit" @click="exitApp">
					<text class="btnExitText">退出</text>
				</div>
			</div>
		</div>

		<!-- 背单词：单词卡（左滑=认识 上滑=模糊 下滑=不会 右滑=退出） -->
		<div if="{{mode === 'study'}}" class="card {{animClass}}">
			<div class="miniExit" @click="exitApp"><text class="miniExitText">退</text></div>
			<div class="prog"><div class="progFill" style="width: {{progPct}}%"></div></div>
			<text class="word">{{curWord.w}}</text>
			<text class="pos">第{{roundNo}}批 {{roundDone}}/{{batchSize}}</text>
			<text class="hint">←认识  ↑模糊  ↓不会  →退出</text>
		</div>

		<!-- 释义页（轻点继续，右滑退出） -->
		<div if="{{mode === 'meaning'}}" class="card animIn">
			<div class="miniExit" @click="exitApp"><text class="miniExitText">退</text></div>
			<text class="word">{{curWord.w}}</text>
			<text class="mean">{{curWord.m}}</text>
			<text class="actText">{{lastActText}}</text>
			<text class="hint2">轻点继续 · 右滑退出</text>
		</div>

		<!-- 今日全部学完 -->
		<div if="{{mode === 'done'}}" class="card animIn">
			<text class="title2">今日完成</text>
			<text class="stat">认识 {{statK}} · 模糊 {{statF}} · 不会 {{statN}}</text>
			<text if="{{retryCount > 0}}" class="stat2">其中 {{retryCount}} 词复考巩固</text>
			<text class="stat2">全部 {{totalCount}} 词已按计划复习</text>
			<div class="btnExit" @click="exitApp">
				<text class="btnExitText">退出</text>
			</div>
			<text class="hint2">右滑退出</text>
		</div>
	</div>
</template>

<script>
import storage from '../../common/storage.js'
import srs from '../../common/srs.js'
import file from '@system.file'
import brightness from '@system.brightness'
import app from '@system.app'
import router from '@system.router'

// v0.21 块架构：词库按块拆成独立小文件（app.ux 推送时写 chiyu_block_N.jsonl），
// 学习时一次只读一块（约 130 词 / 150KB），彻底告别"全库解析 1MB 文件"——
// 那是手环 Vela 运行时反复 OOM 重启的总根源
const MAX_BLOCKS = 32
const BATCH_SIZE = 30      // 每批学习词数（手环内存小，分批加载防 OOM 重启）
const READ_STEP = 128 * 1024  // 块文件内分段读字节数（UTF-16LE，需为偶数）；
// 每块 ~150KB 只需 1-2 次文件调用，点"开始"秒出词

function blockUri(b) { return 'internal://files/chiyu_block_' + b + '.jsonl' }

// UTF-16LE buffer → 字符串（2048 字符/批 fromCharCode.apply，避免超参数上限）
function decode16(buf) {
	var out = ''
	var total = buf.length >> 1
	for (var p = 0; p < total; p += 2048) {
		var n = Math.min(2048, total - p)
		var arr = []
		for (var q = 0; q < n; q++) {
			arr.push(buf[(p + q) * 2 + 1] * 256 + buf[(p + q) * 2])
		}
		out += String.fromCharCode.apply(null, arr)
	}
	return out
}

export default {
	private: {
		mode: 'home',        // home | study | meaning | done
		index: [],           // 轻量索引：全库词仅存 SRS 字段+行号（不存释义，内存可控）
		words: [],           // 当前批次完整词对象（≤BATCH_SIZE 个）
		roundNo: 0,          // 当前批次序号（第几批）
		curBlock: 0,         // 当前学习块（0..MAX_BLOCKS-1，逐块推进）
		batchSize: 0,        // 当前批次词数
		answered: {},        // 本批已答过的词（防重复）
		idx: 0,
		curWord: { w: '', m: '' },
		dueCount: 0,
		totalCount: 0,
		statK: 0,
		statF: 0,
		statN: 0,
		lastActText: '',
		studyStart: 0,     // 当前词显示时刻（用于算反应时间）
		meaningStart: 0,   // 释义显示时刻（用于算停留时间）
		pendingRec: null,  // 待补 dwell 的记录
		gapHours: 24,      // 用户使用频率（小时），打开时估算，决定基础复习间隔
		animClass: 'animIn', // 卡片动画：animIn | flyL | flyU | flyD
		choosing: false,     // 防连点：滑动选词动画期间的输入锁
		roundDone: 0,      // 本批已答题数（含复考）
		progPct: 0,        // 本批进度 %
		retryQueue: [],    // 批内复考队列（选"不会/模糊"的词）
		retryCounts: {},   // 词 → 本批已复考次数（上限 2 次，防循环）
		sinceRetry: 0,     // 距上次复考已走了几步（每 2 步插一次复考）
		retryCount: 0,     // 本批实际复考次数
		debug: '',
		diag1: '',      // 诊断日志（最近一条，推送排障时显示）
		diag2: '',      // 诊断日志（倒数第二条）
		diagTimer: null,
		wordsVer: 0     // 词库版本标记（推送完成时更新，页面据此刷新）
	},
	touch: { sx: 0, sy: 0, active: false },

	onShow() {
		var that = this
		// 块架构：打开只读 storage（total_words / receiving），毫秒级，绝不解析文件
		storage.get('total_words', 0).then(function (n) { that.totalCount = n || 0 })
		// 手环端应用就绪后主动回报握手（配合手机端推送前等待，防止启动慢丢消息）
		try { globalThis.conn && globalThis.conn.send('__hs__', { count: 1 }) } catch (e) { }
		// 打开时估算使用频率，让算法动态定基础间隔（高频→几小时巩固）
		storage.get('records', []).then(function (recs) {
			that.gapHours = srs.estimateGapHours(recs)
		})
		// 推送状态轮询：receiving>0 显示"正在接收词库..."（用户有反馈）；
		// words_ver 变化 → 刷新词库总数。3 秒低频，只读数字，不占资源
		this.diagTimer = setInterval(function () {
			storage.get('receiving', 0).then(function (recv) {
				if (recv > 0) {
					that.debug = '正在接收词库...'
				} else {
					that.debug = ''
				}
			})
			storage.get('words_ver', 0).then(function (v) {
				if (v && v !== that.wordsVer) {
					that.wordsVer = v
					storage.get('total_words', 0).then(function (n) {
						that.totalCount = n || 0
						that.debug = ''
					})
				}
			})
		}, 3000)
	},

	onHide() {
		if (this.diagTimer) { clearInterval(this.diagTimer); this.diagTimer = null }
	},



	startRound() {
		var that = this
		if (this.totalCount > 0) { this.beginRound(); return }
		// total_words 计数未知（storage 可能未同步）：直接探测块 0 文件——
		// 文件在就能学，不依赖计数（v0.23 因计数为 0 直接拦截导致"有词也学不了"）
		this.debug = '正在检查词库...'
		this.readBlockFromFile(0, function (list) {
			if (list && list.length) {
				that.totalCount = list.length
				that.beginRound()
			} else {
				that.debug = '词库为空，请先用手机同步'
			}
		})
	},

	beginRound() {
		this.statK = 0
		this.statF = 0
		this.statN = 0
		this.pendingRec = null
		this.retryCount = 0
		this.debug = ''
		// 从块 0 开始学习（每块取最该复习的 BATCH_SIZE 个词，逐块推进）
		this.curBlock = 0
		this.loadNextBatch()
	},

	// 块架构学习批：读当前块（1 次小文件读，~150KB）→ 合并 SRS 进度 →
	// 按遗忘曲线紧迫度排序 → 取最该复习的 BATCH_SIZE 个词。
	// 每批学完推进到下一块；全部块轮完一轮 → 今日完成。
	loadNextBatch() {
		var that = this
		this.debug = '正在准备单词...'
		var blk = this.curBlock
		this.readBlockFromFile(blk, function (list) {
			if (!list.length) {
				// 该块为空（未同步/已删）：跳到下一块继续找，32 块都空则完成
				that.skipEmptyBlocks(blk)
				return
			}
			// 合并学习进度 + 排序取最紧迫
			storage.get('srsmap', {}).then(function (map) {
				var tmp = []
				for (var i = 0; i < list.length; i++) {
					var w = list[i]
					var s = map[(w.w || '').toLowerCase()]
					if (s) {
						w.e = s.e; w.i = s.i; w.lvl = s.lvl
						w.c = s.c; w.wc = s.wc; w.next = s.next
					}
					var w2 = srs.norm(w)
					tmp.push({ ret: srs.retention(w2), word: w })
				}
				tmp.sort(function (a, b) { return a.ret - b.ret })
				var n = Math.min(BATCH_SIZE, tmp.length)
				var words = []
				for (var k = 0; k < n; k++) words.push(tmp[k].word)
				tmp = null
				try { global.runGC && global.runGC() } catch (e) { }
				if (!words.length) {
					that.skipEmptyBlocks(blk)
					return
				}
				that.words = words
				that.batchSize = words.length
				that.roundNo++
				that.idx = 0
				that.answered = {}
				that.retryQueue = []
				that.retryCounts = {}
				that.sinceRetry = 0
				that.roundDone = 0
				that.animClass = 'animIn'
				that.curWord = words[0]
				that.studyStart = Date.now()
				that.mode = 'study'
				that.debug = ''
				try { brightness.setKeepScreenOn({ keepScreenOn: true }) } catch (e) { }
			})
		})
	},

	// 当前块为空：跳过它继续找下一块；32 块全空 → 今日完成
	skipEmptyBlocks(fromBlk) {
		var next = fromBlk + 1
		if (next >= MAX_BLOCKS) {
			this.mode = 'done'
			this.words = []
			this.debug = ''
			try { brightness.setKeepScreenOn({ keepScreenOn: false }) } catch (e) { }
			return
		}
		this.curBlock = next
		this.loadNextBatch()
	},

	// 读一块词库文件（分段，按实际字节推进；文件回调天然让出事件循环）
	readBlockFromFile(block, cb) {
		var out = []
		var pos = 0
		var remain = ''
		var uri = blockUri(block)
		function parseBlock(text) {
			var parts = text.split('\n')
			remain = parts.pop()
			for (var k = 0; k < parts.length; k++) {
				var l = parts[k].trim()
				if (l) {
					try { out.push(JSON.parse(l)) } catch (e) { }
				}
			}
		}
		function readNext() {
			try {
				file.readArrayBuffer({
					uri: uri,
					position: pos,
					length: READ_STEP,
					success: function (data) {
						var buf = data && data.buffer
						if (!buf || !buf.length) {
							if (remain) {
								var l = remain.trim()
								if (l) { try { out.push(JSON.parse(l)) } catch (e) { } }
							}
							try { global.runGC && global.runGC() } catch (e) { }
							cb(out)
							return
						}
						parseBlock(decode16(buf))
						pos += buf.length          // 按实际读到的字节推进
						readNext()                 // 文件回调天然让出事件循环
					},
					fail: function () { cb(out) }
				})
			} catch (e) { cb(out) }
		}
		readNext()
	},

	onTouchStart(e) {
		var t = e.touches[0]
		this.touch.sx = t.clientX
		this.touch.sy = t.clientY
		this.touch.active = true
	},

	onTouchMove() { },

	onTouchEnd(e) {
		if (!this.touch.active) return
		this.touch.active = false
		var t = (e && e.changedTouches && e.changedTouches[0]) ? e.changedTouches[0] : ((e && e.touches && e.touches[0]) || null)
		if (!t || typeof t.clientX !== 'number') return   // 坐标缺失：直接忽略，绝不误判
		var ex = t.clientX
		var ey = t.clientY
		var dx = ex - this.touch.sx
		var dy = ey - this.touch.sy
		var ax = Math.abs(dx)
		var ay = Math.abs(dy)
		var isTap = ax < 20 && ay < 20
		// 右滑 = 退出应用（任何界面都生效，符合手环习惯）
		if (ax >= ay && dx > 0) {
			this.exitApp()
			return
		}
		// 释义页：轻点继续下一词（同时记下释义停留时间）
		if (this.mode === 'meaning' && isTap) {
			this.nextWord()
			return
		}
		if (isTap) return   // 其它界面轻点忽略
		// 背单词三选一：左滑=认识 上滑=模糊 下滑=不会
		if (this.mode !== 'study') return
		var action = null
		if (ay > ax && dy < 0) action = 'fuzzy'          // 上滑 = 模糊
		else if (ay > ax && dy > 0) action = 'forget'    // 下滑 = 不会
		else if (ax >= ay && dx < 0) action = 'know'     // 左滑 = 认识
		if (action) this.choose(action, Date.now() - this.studyStart)
	},

	exitApp() {
		// 退出前保存当前进度（记录已在 nextWord 时实时写入）
		try { brightness.setKeepScreenOn({ keepScreenOn: false }) } catch (e) { }
		try { app.terminate() } catch (e) { }
		// 兜底：terminate 未生效时清空页面栈回到桌面
		setTimeout(function () {
			try { router.clear() } catch (e) { }
		}, 300)
	},

	onBackPress() {
		// 手环物理返回键：答题中回首页，首页/完成页直接退出
		if (this.mode === 'study' || this.mode === 'meaning') {
			this.mode = 'home'
			this.pendingRec = null
			try { brightness.setKeepScreenOn({ keepScreenOn: false }) } catch (e) { }
		} else {
			this.exitApp()
		}
		return true
	},

	choose(action, rt) {
		// 保险版：无 choosing 锁、无 setTimeout——曾因 setTimeout 在 Vela 上不触发，
		// choosing 锁永不释放导致所有手势失效。现在同步执行，100% 可靠。
		// 先更新 SRS（含反应时间 + 使用频率），记录暂存，释义停留后补 dwell 再落盘
		var rec = srs.updateWord(this.curWord, action, { rt: rt, gap: this.gapHours })
		this.pendingRec = rec
		if (action === 'know') this.statK++
		else if (action === 'fuzzy') this.statF++
		else this.statN++
		this.lastActText = action === 'know' ? '认识 ✓' : (action === 'fuzzy' ? '模糊 ~' : '不会 ✗')
		this.roundDone++
		this.progPct = Math.min(100, Math.round(this.roundDone / this.batchSize * 100))
		// 轮内复考：选"不会/模糊"的词进队列，每走 2 步插回来再考一次（同词最多复考 2 次）
		if (action !== 'know') {
			var key = (this.curWord.w || '').toLowerCase()
			var done = this.retryCounts[key] || 0
			if (done < 2) {
				var inQueue = false
				for (var q = 0; q < this.retryQueue.length; q++) {
					if (this.retryQueue[q].key === key) { inQueue = true; break }
				}
				if (!inQueue) {
					this.retryQueue.push({ key: key, word: this.curWord, times: 1 })
				}
			}
		}
		// 进释义页（同步，无动画等待）
		this.showMeaning()
	},

	showMeaning() {
		this.choosing = false
		this.mode = 'meaning'
		this.meaningStart = Date.now()
	},

	nextWord() {
		// 补上释义停留时间，落盘记录
		if (this.pendingRec) {
			this.pendingRec.dwell = Date.now() - this.meaningStart
			var that = this
			storage.get('records', []).then(function (recs) {
				recs.push(that.pendingRec)
				if (recs.length > 500) recs = recs.slice(recs.length - 500)
				storage.set('records', recs)
			})
			// SRS 学习进度独立落盘（词库与进度分离：推送只替换词库，学习进度永不丢）
			var cw = this.curWord
			storage.get('srsmap', {}).then(function (map) {
				map[(cw.w || '').toLowerCase()] = { e: cw.e, i: cw.i, lvl: cw.lvl, c: cw.c, wc: cw.wc, next: cw.next }
				storage.set('srsmap', map)
			})
			this.pendingRec = null
		}
		this.answered[this.curWord.w.toLowerCase()] = true
		// 轮内复考：每走 2 步，从队列取一个"不会/模糊"的词回来再考
		// 复考时更新 SRS 状态（第二次作答更准），答对即出队，仍不会继续排队（最多 2 次）
		this.sinceRetry++
		if (this.retryQueue.length && this.sinceRetry >= 2) {
			var rw = this.retryQueue.shift()
			this.sinceRetry = 0
			this.retryCount++
			this.retryCounts[rw.key] = (this.retryCounts[rw.key] || 0) + 1
			this.curWord = rw.word
			this.studyStart = Date.now()
			this.mode = 'study'
			this.animClass = 'animIn'
			this.debug = '复考:' + rw.key
			return
		}
		this.debug = ''
		// 批内顺序推进（本批已是全库最紧急的一批）
		this.idx++
		if (this.idx < this.words.length) {
			this.curWord = this.words[this.idx]
			this.studyStart = Date.now()
			this.mode = 'study'
			this.animClass = 'animIn'
		} else {
			// 本批学完：更新索引+落盘进度，自动加载下一批
			this.batchDone()
		}
	},

	batchDone() {
		var that = this
		// 本批学习进度合并写入 srsmap（推送只替换词库，进度永不丢）
		storage.get('srsmap', {}).then(function (map) {
			for (var i2 = 0; i2 < that.words.length; i2++) {
				var cw = that.words[i2]
				map[(cw.w || '').toLowerCase()] = { e: cw.e, i: cw.i, lvl: cw.lvl, c: cw.c, wc: cw.wc, next: cw.next }
			}
			storage.set('srsmap', map)
		})
		// 释放本批完整词对象，推进到下一块
		this.words = []
		this.answered = {}
		try { global.runGC && global.runGC() } catch (e) { }
		this.curBlock++
		if (this.curBlock >= MAX_BLOCKS) {
			// 全部块轮完一轮 → 今日完成（每块每轮取最紧迫的 BATCH_SIZE 个词）
			this.curBlock = 0
			this.mode = 'done'
			this.idx = 0
			this.debug = ''
			try { brightness.setKeepScreenOn({ keepScreenOn: false }) } catch (e) { }
			return
		}
		this.loadNextBatch()
	}
}
</script>

<style>
/* AstroBox 风格：深色 #0D0D0F · 主色 #1781FF · 大圆角卡片 */
.page {
	width: 212px;
	height: 520px;
	background-color: #0D0D0F;
	flex-direction: column;
	align-items: center;
}

/* 入场动画：缩放 + 淡入 */
@keyframes popIn {
	from { transform: scale(0.92); opacity: 0; }
	to { transform: scale(1); opacity: 1; }
}

.animIn {
	animation: popIn 0.3s cubic-bezier(0.18, 0.86, 0.34, 1);
}

/* 三向飞出动画：左=认识 上=模糊 下=不会（AstroBox 式滑动反馈） */
@keyframes flyL {
	to { transform: translateX(-240px); opacity: 0; }
}

@keyframes flyU {
	to { transform: translateY(-560px); opacity: 0; }
}

@keyframes flyD {
	to { transform: translateY(560px); opacity: 0; }
}

