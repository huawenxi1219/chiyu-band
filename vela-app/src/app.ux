<script>
// 池鱼单词 - 应用入口：处理与手机的互连（握手 + 词表推送 + 记录回收）
import Interconn from './common/interconn.js'
import storage from './common/storage.js'
import file from '@system.file'
import brightness from '@system.brightness'

globalThis.conn = new Interconn()

// 词库文件：v0.21 起按块拆成独立小文件（words_0.jsonl ... words_31.jsonl）。
// 学习时一次只读一块（约 150KB），从根上避免"全库解析 1MB 文件"——
// 手环 Vela 运行时对整库 JSON 解析的内存/CPU 承受不了，是反复 OOM 重启的总根源。
// 每块一个文件还天然解决：序号校验、断点重推、不漏词（块文件行数=手机端发来的词数）。
const MAX_BLOCKS = 32
function blockUri(b) { return 'internal://files/chiyu_block_' + b + '.jsonl' }

// 接收开始：清掉旧单文件词库 + 重置计数。
// 注意：不逐块循环删除旧块文件（32 次 file.delete 会占大量时间拖慢推送），
// 每块由 writeBlockToFile 写前单独 delete，天然幂等。
function clearOldWords() {
  try { file.delete({ uri: 'internal://files/chiyu_words.jsonl', success: function () { }, fail: function () { } }) } catch (e) { }
  try { storage.set('total_words', 0) } catch (e) { }
}

// 诊断日志：记录每条关键消息，写入共享存储（跨应用实例可见，首页轮询显示）
globalThis.__diag = []
globalThis.diag = function (tag, msg) {
  try {
    var d = new Date()
    var h = d.getHours(), m = d.getMinutes(), s = d.getSeconds()
    var ts = (h < 10 ? '0' + h : h) + ':' + (m < 10 ? '0' + m : m) + ':' + (s < 10 ? '0' + s : s)
    globalThis.__diag.push(ts + ' ' + tag + (msg ? ' ' + msg : ''))
    if (globalThis.__diag.length > 24) globalThis.__diag.shift()
    try {
      storage.set('diag', globalThis.__diag)
    } catch (e2) { }
  } catch (e) { }
}
globalThis.diag('app', 'started')

// 应用启动后短暂保持常亮（兜底窗口）：手机端 openApp 拉起本应用后屏幕极易熄
// 灭，熄屏后 interconnect 消息收不到；保持 15 秒亮屏等推送开始指令到达
try { brightness.setKeepScreenOn({ keepScreenOn: true }) } catch (e) { }
setTimeout(function () {
  try { brightness.setKeepScreenOn({ keepScreenOn: false }) } catch (e) { }
}, 15000)

// 握手协议（与手机端"池鱼手环同步"约定一致）
globalThis.conn.on('__hs__', (payload) => {
  const count = (payload && payload.count) || 0
  globalThis.diag('hs', 'count=' + count)
  if (count < 2) {
    globalThis.conn.send('__hs__', { count: count + 1 })
  }
})

// 手机推送词表（可靠分块协议：start→逐块确认→done）
// 推送期间边收边写文件（内存恒定，仿喵喵电子书流式落盘），收齐后合并 SRS 状态写 storage
// 文件读写统一用 writeArrayBuffer/readArrayBuffer + UTF-16LE（喵喵验证过的链路，
// writeText 的 append/覆盖行为在本环境不可靠，曾导致词库文件为空）
const pushState = { expected: 0, recvCount: 0, total: -1 }

// 字符串 → UTF-16LE Uint8Array（与喵喵 str2abWrite 完全一致：
// 必须返回 Uint8Array，直接传 ArrayBuffer 会被 Vela file API 抛 TypeError）
function str2abUtf16(str) {
  var array = new Uint16Array(str.length)
  for (var i = 0; i < str.length; i++) {
    array[i] = str.charCodeAt(i)
  }
  return new Uint8Array(array.buffer)
}

// 把一块词写入该块对应文件（words_{batch}.jsonl，UTF-16LE）。
// 关键：Vela 的 file.writeArrayBuffer 对"不存在的文件"用覆盖写会失败
// （喵喵验证过的稳定链路是追加写自动建文件）。因此先删除旧块文件
// （不存在则忽略失败），再追加写——同一块重发时先删后写，天然幂等不重复。
function writeBlockToFile(batch, words) {
  return new Promise(function (resolve, reject) {
    var text = ''
    for (var i = 0; i < words.length; i++) {
      try { text += JSON.stringify(words[i]) + '\n' } catch (e) { }
    }
    var uri = blockUri(batch)
    var done = false
    var timer = setTimeout(function () {
      if (!done) {
        done = true
        globalThis.diag('push', 'WRITE TIMEOUT skip b' + batch)
        resolve()
      }
    }, 3000)
    function doWrite() {
      try {
        global.runGC && global.runGC()
        file.writeArrayBuffer({
          uri: uri,
          buffer: str2abUtf16(text),
          append: true,
          success: function () {
            if (!done) { done = true; clearTimeout(timer); resolve() }
          },
          fail: function (e) {
            if (!done) { done = true; clearTimeout(timer); reject(e) }
          }
        })
      } catch (e) {
        if (!done) { done = true; clearTimeout(timer); reject(e) }
      }
    }
    try {
      file.delete({ uri: uri, success: function () { doWrite() }, fail: function () { doWrite() } })
    } catch (e) { doWrite() }
  })
}

// 推送收尾：文件已是完整词库（每词一行，手机端为权威），无需合并、
// 无需大对象驻留——学习进度（SRS 状态）独立存 storage 'srsmap'，推送不受影响。
// 首页在 words_ver 变化后重新读文件 + 合并 srsmap 显示。

globalThis.conn.on('word_push_start', (payload) => {
  try {
    pushState.expected = 0
    pushState.recvCount = 0
    pushState.total = (payload && payload.total) || 0
    globalThis.diag('start', 'total=' + pushState.total)
    // 置接收中标记：首页此时不加载词库（推送过程零词库加载，防应用被拉起时 OOM 重启）
    // 同时记录起始时间戳，供首页识别"推送中断残留"的僵尸标记（超 30 秒自动忽略并加载）
    try {
      storage.set('receiving', pushState.total)
      storage.set('receivingAt', Date.now())
    } catch (e) { }
    // 开始新一轮推送前清空旧词库文件（防半截残留/重复追加）
    try { clearOldWords() } catch (e) { }
    // 强制屏幕常亮：手环应用熄屏/后台时收不到 interconnect 消息，必须保持前台
    try { brightness.setKeepScreenOn({ keepScreenOn: true }) } catch (e) { }
    globalThis.conn.send('push_ready', { ok: true, total: pushState.total })
    globalThis.diag('start', 'sent push_ready')
  } catch (e) { globalThis.diag('start', 'ERR ' + e) }
})

globalThis.conn.on('word_push', (payload) => {
  // 收到块消息的瞬间立即打点（即使后续处理异常也有记录）
  try {
    var pb = (payload && payload.batch) || -9
    globalThis.diag('push', 'RAW batch=' + pb)
  } catch (e) { }
  try {
    const batch = (payload && payload.batch) || 0
    const words = (payload && payload.words) || []
    globalThis.diag('push', 'batch=' + batch + ' exp=' + pushState.expected + ' words=' + words.length)
    // 序号对不上 = 缺块，请求手机端重发当前期望序号
    if (batch !== pushState.expected) {
      globalThis.conn.send('push_next', { count: pushState.expected })
      globalThis.diag('push', 'mismatch, req ' + pushState.expected)
      return
    }
    // 边收边写块文件（每块独立文件，覆盖写幂等；先写盘再回确认）
    writeBlockToFile(batch, words).then(function () {
      pushState.expected++
      pushState.recvCount += words.length
      // 每 10 块主动垃圾回收（仿喵喵电子书，防内存累积触发系统杀进程）
      if (pushState.expected % 10 === 0) {
        try { global.runGC && global.runGC() } catch (e) { }
      }
      if (pushState.expected >= pushState.total) {
        // 收齐：全部块文件已落盘（每块行数=手机端发来的词数，天然不漏词）。
        // 学习进度独立存 srsmap，无需合并
        globalThis.diag('push', 'all received ' + pushState.recvCount)
        try {
          storage.set('receiving', 0)
          storage.set('receivingAt', 0)
          storage.set('total_words', pushState.recvCount)
        } catch (e2) { globalThis.diag('push', 'STORAGE ERR ' + e2) }
        try { brightness.setKeepScreenOn({ keepScreenOn: false }) } catch (e2) { }
        globalThis.conn.send('push_done', { count: pushState.recvCount, total: pushState.total })
        globalThis.diag('push', 'done, blocks saved')
        // 通知首页刷新词库
        try { storage.set('words_ver', Date.now()) } catch (e2) { globalThis.diag('push', 'VER ERR ' + e2) }
        pushState.expected = 0
        pushState.recvCount = 0
        pushState.total = -1
      } else {
        // 确认已收到本块，请求下一块
        globalThis.conn.send('push_next', { count: pushState.expected })
        globalThis.diag('push', 'ack ' + pushState.expected)
      }
    }).catch(function (e) {
      // 写盘失败：记录并跳过该块（不卡死链路），继续推进序号
      globalThis.diag('push', 'WRITE ERR ' + e)
      pushState.expected++
      pushState.recvCount += words.length
      if (pushState.expected >= pushState.total) {
        globalThis.diag('push', 'all received ' + pushState.recvCount + ' (partial)')
        try { storage.set('receiving', 0); storage.set('total_words', pushState.recvCount) } catch (e2) { }
        try { brightness.setKeepScreenOn({ keepScreenOn: false }) } catch (e2) { }
        globalThis.conn.send('push_done', { count: pushState.recvCount, total: pushState.total })
        globalThis.diag('push', 'done, blocks saved (partial)')
        try { storage.set('words_ver', Date.now()) } catch (e2) { }
        pushState.expected = 0
        pushState.recvCount = 0
        pushState.total = -1
      } else {
        globalThis.conn.send('push_next', { count: pushState.expected })
      }
    })
  } catch (e) { globalThis.diag('push', 'ERR ' + e) }
})

// 手机请求收回学习记录
globalThis.conn.on('record_pull', () => {
  globalThis.diag('pull', 'requested')
  storage.getAll().then(obj => {
    const recs = obj.records || []
    globalThis.conn.send('record_back', { records: recs })
    globalThis.diag('pull', 'sent ' + recs.length)
    obj.records = []   // 发送后清空本地
    storage.saveAll(obj)
  })
})

export default {}
</script>
