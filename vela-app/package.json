{
  "name": "chiyu-words-vela",
  "version": "0.1.0",
  "description": "池鱼单词 - 小米手环10 背单词极简应用（遗忘曲线智能提问）",
  "engines": {
    "node": ">=8.10"
  },
  "scripts": {
    "start": "aiot server --watch --open-nuttx --enable-custom-component true",
